# Copy this file to .env.local and fill in your Supabase project values.
# Both are safe to expose in the browser — the anon key is protected by
# row-level security. .env.local is gitignored; never commit real keys.
#
# Find these in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
